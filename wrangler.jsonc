{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bitllm-landing",
  "main": "src/index.js",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "NETWORK",
      "id": "7295150c7ffd436b8e5eb845089d89ce"
    }
  ],
  // Keeps /network.json fresh: a one minute cron dispatches the node repo's
  // workflow whenever the snapshot is more than three minutes old, so the map
  // lands about every four minutes. See scheduled() in src/index.js.
  "triggers": {
    "crons": ["*/1 * * * *"]
  },
  // The bitllm.org zone is in this account (Zjj1993, 5119540a…). These are
  // zone routes, not custom domains: the existing proxied records stay, and
  // the Worker answers for both hostnames at the edge.
  "routes": [
    { "pattern": "bitllm.org/*", "zone_name": "bitllm.org" },
    { "pattern": "www.bitllm.org/*", "zone_name": "bitllm.org" }
  ]
}
