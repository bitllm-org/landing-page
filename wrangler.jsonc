{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bitllm-landing",
  "main": "src/index.js",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
  // The bitllm.org and www.bitllm.org custom domains are attached after the
  // zone moves to the BitLLM Cloudflare account. Attaching them now would take
  // the live site away from the old host before the transfer.
}
