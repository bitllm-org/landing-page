{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bitllm-landing",
  "main": "src/index.js",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "NETWORK",
      "id": "7295150c7ffd436b8e5eb845089d89ce"
    }
  ],
  // Keeps /network.json fresh when the node repo's own cron does not fire: the
  // Worker dispatches that workflow if the snapshot is more than 15 minutes
  // old. See the scheduled() handler in src/index.js.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // The bitllm.org zone is in this account (Zjj1993, 5119540a…). These are
  // zone routes, not custom domains: the existing proxied records stay, and
  // the Worker answers for both hostnames at the edge.
  "routes": [
    { "pattern": "bitllm.org/*", "zone_name": "bitllm.org" },
    { "pattern": "www.bitllm.org/*", "zone_name": "bitllm.org" }
  ]
}
