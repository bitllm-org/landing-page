{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bitllm-landing",
  "main": "src/index.js",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "bitllm.org", "custom_domain": true },
    { "pattern": "www.bitllm.org", "custom_domain": true }
  ]
}
